PORT=3000

# MongoDB connection string (local or Atlas)
MONGODB_URI=mongodb://localhost:27017/workforce

# Directory where uploaded onboarding training materials are stored on disk.
# Defaults to ./uploads if unset — point this at a mounted persistent volume in production.
UPLOADS_DIR=./uploads

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# Platform admin (the SaaS owner's super-admin login, POST /platform-admin/login).
# On first boot, if no PlatformAdmin exists yet, one is created from these two — set them once,
# then you can blank them out (or leave them; boot is a no-op once the account exists).
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_JWT_SECRET=change-me-platform-admin-secret

# Lemon Squeezy billing — from your Lemon Squeezy dashboard (Settings > API, and Store settings
# for the store id). LEMONSQUEEZY_WEBHOOK_SECRET is the signing secret you set when you add the
# webhook endpoint (POST {this API}/billing/webhook) in Lemon Squeezy.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
# One variant id per plan in src/billing/plans.ts — each is the "variant" you create for that
# plan's monthly product in Lemon Squeezy.
LEMONSQUEEZY_VARIANT_STARTER=
LEMONSQUEEZY_VARIANT_GROWTH=
LEMONSQUEEZY_VARIANT_SCALE=

# Base URL of the workforce-admin web app — used to build the checkout's post-payment redirect.
ADMIN_APP_URL=http://localhost:3001
